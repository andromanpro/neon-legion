config.toml
roles.toml
CLAUDE.local.md
.env
.env.local

# Sanitization backups — pre-OSS originals with personal data, must NEVER be pushed
.oss-backup/

# Private sanitization rules — see .oss-sanitize-private.example.txt
.oss-sanitize-private.txt

# Local snapshot artifacts
dashboard/snapshot.json
dashboard/snapshot-*.json
docs/screenshots/.tmp/

# IDE / OS / build artifacts
.serena/
.idea/
.vscode/
__pycache__/
*.pyc
*.pyo
.DS_Store
*.tmp
*.log
.~lock.*
~$*

# Codex sandbox leftovers — process creates these as workspace-temp inside
# the cwd, locks them with AppContainer ACL, then exits without cleanup.
# Removal requires `takeown /f tmp* /r /d y && rd /s /q tmp*` from admin
# PowerShell (or just delete from File Explorer with admin perms).
codex-tests.tmp/
pytestdir/
demo-smoke-*/
tmp[a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9]/
