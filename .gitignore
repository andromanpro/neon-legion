# Runtime data (event streams, locks, task store, generated dashboard inputs)
tracker/*.jsonl
tracker/*.lock
tracker/.last-uuids.json
tracker/tasks.json
tracker/.estimation-logs/
tracker/private/
tracker/diff_cost.json
tracker/regressions.json
tracker/slippage.json
tracker/slop.json
tracker/reputation.json
# Frozen per-session human-prompt timestamps (session ids + activity times).
# Timestamps only, never prompt text — but still personal activity data.
tracker/human-attention.json
prompts/private/
orchestrate-runs/

# Per-environment config / agent notes (use config.example.toml + CLAUDE.example.md as templates)
config.toml
roles.toml
CLAUDE.local.md
.env
.env.local

# Sanitization backups — pre-OSS originals with personal data, must NEVER be pushed
.oss-backup/

# Private sanitization rules — see .oss-sanitize-private.example.txt
.oss-sanitize-private.txt

# Local snapshot artifacts
dashboard/snapshot.json
dashboard/snapshot-*.json
docs/screenshots/.tmp/

# Per-run artifacts generated by tools/consensus_matrix.py — re-runnable
# locally; not a tracked deliverable.
docs/sample-run/consensus.md
orchestrate-runs/*/consensus.md

# Per-agent capability cards generated by tools/capability_cards.py from
# `tracker/reputation.json`. Refreshed locally on demand.
docs/capability/*.md
!docs/capability/README.md

# Reverse-autopilot proposals — derived from local transcript history.
# May surface project paths / private details; review by hand before
# committing any individual proposal.
proposals/repeat-*.md

# IDE / OS / build artifacts
.serena/
.idea/
.vscode/
__pycache__/
*.pyc
*.pyo
.DS_Store
*.tmp
*.tmp.*
*.log
.~lock.*
~$*

# Codex sandbox leftovers — process creates these as workspace-temp inside
# the cwd, locks them with AppContainer ACL, then exits without cleanup.
# Removal requires `takeown /f tmp* /r /d y && rd /s /q tmp*` from admin
# PowerShell (or just delete from File Explorer with admin perms).
codex-tests.tmp/
pytestdir/
demo-smoke-*/
git-diff-cost-*/
not-git-*/
tmp[a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9][a-z_0-9]/
