digraph NeonLegion {
    rankdir=LR;
    bgcolor="#020617";
    node [fontname="Arial", fontcolor="#F8FAFC", style="rounded,filled", color="#00D4FF", fillcolor="#0a1429", penwidth=2, shape=box];
    edge [color="#00D4FF", fontcolor="#F8FAFC", fontname="Arial", penwidth=1.5];

    USER [shape=circle, label="Я\n(approver)", fillcolor="#1b0b2f", color="#FF2EC4"];
    TG [label="Telegram"];
    OC [label="OpenClaw\nна NAS\n(мост)"];
    CLAUDE [label="Claude\nархитектор\n(план + ревью)"];
    CODEX [label="Codex\nразработчик\n(код + тесты)"];
    DS [label="DeepSeek\nтретий ревьюер\n(аудит)"];
    GIT [label="Gitea\nPR + merge"];
    TR [shape=cylinder, label="Трекер\nJSONL\n+ дашборд", fillcolor="#0a1429", color="#64FFDA"];

    USER -> TG [label="команда"];
    TG -> OC;
    OC -> CLAUDE [label="задача"];
    CLAUDE -> CODEX [label="план"];
    CODEX -> CLAUDE [label="PR"];
    CLAUDE -> DS [label="финальный аудит"];
    DS -> USER [label="approve / правки"];
    USER -> GIT [label="merge"];

    CLAUDE -> TR [style=dashed, label="события", color="#64FFDA", fontcolor="#64FFDA"];
    CODEX -> TR [style=dashed, color="#64FFDA"];
    DS -> TR [style=dashed, color="#64FFDA"];
    OC -> TR [style=dashed, color="#64FFDA"];
}
