digraph NeonLegion {
    rankdir=LR;
    bgcolor="#020617";
    node [fontname="Arial", fontcolor="#F8FAFC", style="rounded,filled", color="#00D4FF", fillcolor="#0a1429", penwidth=2, shape=box];
    edge [color="#00D4FF", fontcolor="#F8FAFC", fontname="Arial", penwidth=1.5];

    USER [shape=circle, label="You\n(approver)", fillcolor="#1b0b2f", color="#FF2EC4"];
    TG [label="Telegram"];
    OC [label="OpenClaw\non NAS\n(bridge)"];
    CLAUDE [label="Claude\narchitect\n(plan + review)"];
    CODEX [label="Codex\ndeveloper\n(code + tests)"];
    DS [label="DeepSeek\nthird reviewer\n(audit)"];
    GIT [label="Gitea\nPR + merge"];
    TR [shape=cylinder, label="Tracker\nJSONL\n+ dashboard", fillcolor="#0a1429", color="#64FFDA"];

    USER -> TG [label="command"];
    TG -> OC;
    OC -> CLAUDE [label="task"];
    CLAUDE -> CODEX [label="plan"];
    CODEX -> CLAUDE [label="PR"];
    CLAUDE -> DS [label="final audit"];
    DS -> USER [label="approve / fixes"];
    USER -> GIT [label="merge"];

    CLAUDE -> TR [style=dashed, label="events", color="#64FFDA", fontcolor="#64FFDA"];
    CODEX -> TR [style=dashed, color="#64FFDA"];
    DS -> TR [style=dashed, color="#64FFDA"];
    OC -> TR [style=dashed, color="#64FFDA"];
}
